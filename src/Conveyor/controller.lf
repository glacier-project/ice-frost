    ############################## FROST ##############################
    method _prepare_message(position){= 
        if position == "0":
            return 0
        return [[position], [ControllerCommand.move, BayAction.none], [None]]
    =}
    method _get_pallet_position(palletNum){=
        if palletNum == self.bay1_status[0]:
            return BayName.Bay1_1.value
        elif palletNum == self.lu_bay_status[0]:
            return BayName.LU.value
        for i, pallet in enumerate(self.bay2_status):
            if pallet == palletNum:
                return getattr(BayName, f"Bay2_{i+1}").value
        for i, pallet in enumerate(self.bay3_status):
            if pallet == palletNum:
                return getattr(BayName, f"Bay3_{i+1}").value
        for i, pallet in enumerate(self.bay4_status):
            if pallet == palletNum:
                return getattr(BayName, f"Bay4_{i+1}").value
        return "0"
    =}
    // @label from_frost
    reaction(from_frost)-> message_to_send{=
        palletNum = from_frost.value[0]
        destination = from_frost.value[1]
        # Validate palletNum and destination
        if palletNum not in self.pallet_names:
            raise Exception(f"Controller error: pallet {palletNum} not recognized")       
        if destination not in BayName.values() and destination != "0":
            raise Exception(f"Controller error: invalid destination {destination} for pallet {palletNum}")

        self.pallet_destinations[palletNum] = destination  
        position = self._get_pallet_position(palletNum)
        self.logger.debug(f"Controller received from FROST: pallet {palletNum} at position {position} with new destination {destination}")
        if position == "0":
            self.logger.debug(f"Pallet {palletNum} destination updated to {destination}")
            return 0
        else:
            if position != "0":  
                self.messages.append(self._prepare_message(position))
                message_to_send.schedule(int(len(self.messages) + 1))
    =}

}
