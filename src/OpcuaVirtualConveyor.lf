target Python;

import FrostMachine from "../frost/src/lib/FrostMachine.lf"


reactor OpcuaVirtualConveyor extends FrostMachine {

    # data model nodes
    state callFreePalletToWithReservation
    state destination_palletid_5
    state destination_palletid_4_2
    state setPalletDestination
    state releasePallet

    # simulate time that it takes for the pallet movement
    timer delayed_destination_palletid_5(10 sec)
    timer delayed_destination_palletid_4_2(25 sec)

    /*
        parameters:
        - !!NumericalVariableNode
            name: "destination"
            description: ""
            measure_unit: "NoneMeasureUnits.NONE"
            default_value: 0
        - !!NumericalVariableNode
            name: "reservationId"
            description: ""
            measure_unit: "NoneMeasureUnits.NONE"
            default_value: 0
        returns:
        - !!BooleanVariableNode
            name: "result"
            description: ""
        - !!NumericalVariableNode
            name: "palletNumber"
            description: ""
            measure_unit: "NoneMeasureUnits.NONE"
    */
    method callFreePalletToWithReservationCallback(destination, reservationId){=
        self.logger.info(f"[callFreePalletToWithReservation] Callback called with {destination=}, {reservationId=}")
        return (True, 2)
    =}

    /**
        parameters:
        - !!NumericalVariableNode
            name: "palletNumber"
            description: ""
            measure_unit: "NoneMeasureUnits.NONE"
            default_value: 0
        - !!NumericalVariableNode
            name: "destination"
            description: ""
            measure_unit: "NoneMeasureUnits.NONE"
            default_value: 0
        returns:
        - !!BooleanVariableNode
            name: "result"
            description: ""
    */
    method setPalletDestinationCallback(palletNumber, destination) {=
        self.logger.info(f"[setPalletDestinationCallback] Callback called with {palletNumber=}, {destination=}")
        return True
    =}

    /*
        parameters:
        - !!NumericalVariableNode
            name: "palletNumber"
            description: ""
            measure_unit: "NoneMeasureUnits.NONE"
            default_value: 0
        returns:
        - !!BooleanVariableNode
            name: "result"
            description: ""
    */

    method releasePalletCallback(palletNumber) {=
        self.logger.info(f"[releasePalletCallback] Callback called with {palletNumber=}")
        return True
    =}

    reaction(startup){=
        self.logger.info("[startup] OpcuaConveyor started.")

        self.callFreePalletToWithReservation = self.data_model.get_node("/Objects/ConveyorHMI/ConveyorDataExchange/Commands/ConveyorCommandsPointer/callFreePalletToWithReservation")
        self.callFreePalletToWithReservation.callback = self.callFreePalletToWithReservationCallback
        self.logger.info(f"[startup] {self.callFreePalletToWithReservation=}")

        self.destination_palletid_5 = self.data_model.get_node("/Objects/ConveyorHMI/ConveyorDataExchange/Destinations/destination_palletid_5")
        self.logger.info(f"[startup] {self.destination_palletid_5=}")

        self.destination_palletid_4_2 = self.data_model.get_node("/Objects/ConveyorHMI/ConveyorDataExchange/Destinations/destination_palletid_4_2")
        self.logger.info(f"[startup] {self.destination_palletid_4_2=}")

        self.setPalletDestination = self.data_model.get_node("/Objects/ConveyorHMI/ConveyorDataExchange/Commands/ConveyorCommandsPointer/setPalletDestination")
        self.setPalletDestination.callback = self.setPalletDestinationCallback
        self.logger.info(f"[startup] {self.setPalletDestination=}")

        self.releasePallet = self.data_model.get_node("/Objects/ConveyorHMI/ConveyorDataExchange/Commands/ConveyorCommandsPointer/releasePallet")
        self.releasePallet.callback = self.releasePalletCallback
        self.logger.info(f"[startup] {self.releasePallet=}")
    =}

    reaction(delayed_destination_palletid_5) {=
        self.logger.info(f"[delayed_destination_palletid_5] Updating destination_palletid_5 to the palletNumber 2")
        self.destination_palletid_5.value = 2
    =}

    reaction(delayed_destination_palletid_4_2) {=
        self.logger.info(f"[delayed_destination_palletid_4_2] Updating destination_palletid_4_2 to the palletNumber 2")
        self.destination_palletid_4_2.value = 2
    =}
}
