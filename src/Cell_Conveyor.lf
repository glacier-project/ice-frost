    state segment_8 
    
    //METHODS
    state setPalletDestination
    state callFreePalletTo
    state callFreePalletToWithReservation
    state callFreePalletOfTypeTo
    state callFreePalletOfTypeToWithReservation
    state reservePallet
    state getReservedPallet
    state reserveFreePalletofType2
