target Python

import MissionMachine from "base/MissionMachine.lf"

reactor Kairos extends MissionMachine{
    method mission_nodes(){=
        base = "RBKairos/Mission_Methods/"
        return (base + "Control_Busy", base + "Ongoing_Mission_Name", base + "Last_Mission_Result", base + "Missions_Call_Counter")
    =}
}
