target Python

import FrostReactor from <frost/FrostReactor.lf>

preamble{=
from vertical_warehouse import VerticalWarehouse, WarehouseController
=}

reactor Warehouse(tick_period = 50 msec) extends FrostReactor{
    state wh
    state ctrl
    state tray_in_bay
    state bay_busy
    state bay_ready
    state bay_queue_size
    state tray_calls_count

    timer tick(0, tick_period)

    reaction(startup){=
        dm = self.data_model
        self.wh = VerticalWarehouse(dt=self.tick_period / 1e9)
        self.ctrl = WarehouseController(self.wh)

        self.tray_in_bay = dm.get_node("Warehouse/Status/trayInBay")
        self.bay_busy = dm.get_node("Warehouse/Status/bayBusy")
        self.bay_ready = dm.get_node("Warehouse/Status/bayReadyForPickPlace")
        self.bay_queue_size = dm.get_node("Warehouse/Status/bayQueueSize")
        self.tray_calls_count = dm.get_node("Warehouse/Statistics/TrayCallsCount")

        dm.get_node("Warehouse/SocketLink/extract").callback = self.extract
        dm.get_node("Warehouse/SocketLink/sendback").callback = self.sendback
        dm.get_node("Warehouse/SocketLink/enqueueTray").callback = self.enqueue
        dm.get_node("Warehouse/SocketLink/requestInfoBay").callback = self.ctrl.request_info_bay
        dm.get_node("Warehouse/SocketLink/clearBay").callback = self.clear_bay
        dm.get_node("Warehouse/showMessage").callback = lambda message: self.logger.info(message)
        self.publish_status()
    =}

    method extract(TrayNumber){=
        ok = self.ctrl.extract(int(TrayNumber))
        if ok:
            self.tray_calls_count.value = self.tray_calls_count.value + 1
        return ok
    =}

    method sendback(TrayNumber){=
        # TrayNumber must be the tray in the bay. 0 means "whatever is in the bay".
        if int(TrayNumber) not in (0, self.wh.tray_in_bay):
            return False
        return self.ctrl.sendback()
    =}

    method enqueue(TrayNumber){=
        return int(TrayNumber) if self.ctrl.enqueue(int(TrayNumber)) else 0
    =}

    method clear_bay(){=
        ok = self.ctrl.clear_bay()
        self.publish_status()
        return ok
    =}

    method publish_status(){=
        n = self.wh.tray_in_bay
        self.tray_in_bay.value = n
        self.bay_busy.value = n > 0
        self.bay_ready.value = n > 0
        self.bay_queue_size.value = self.wh.queue_occupancy()
    =}

    reaction(tick){=
        if not self.ctrl.is_busy:
            return
        if not self.ctrl.tick():
            self.logger.error("Warehouse mission aborted: pick/place failed")
        if not self.ctrl.is_busy:
            self.publish_status()
    =}

    reaction(new_method_request) -> channel_out{=
        for bank_index, message in new_method_request.value:
            self._set_channel_out_port(self.protocol_mng.handle_message(message), channel_out)
    =}
}
