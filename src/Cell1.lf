target Python

import FrostReactor from <frost/FrostReactor.lf>

reactor Cell1 extends FrostReactor{
    preamble {=
        import random
        # tempi di cattura della ricetta in secondi: (mediana, minimo, massimo)
        MISSION_TIME = {"BoardIn": (4.1, 4.0, 4.5), "TestingBoard": (63.0, 61.0, 65.0), "BoardOut": (2.1, 0.9, 3.3)}
    =}
    state busy
    state current_mission
    state last_result
    state running = False      # True dall'inizio alla fine di una missione
    state mission_end
    logical action end_mission

    method begin_mission(mission){=
        if self.running:
            return False        # come la macchina vera: una missione per volta
        self.running = True
        self.last_result.value = ""
        self.busy.value = True
        self.current_mission.value = mission
        median, low, high = self.MISSION_TIME[mission]
        self.mission_end.schedule(MSEC(int(self.random.triangular(low, high, median) * 1000)))
        return True
    =}

    method board_in(){=
        return self.begin_mission("BoardIn")
    =}

    method start_test(serialNumber){=
        self.logger.info(f"Test della scheda {serialNumber}")
        return self.begin_mission("TestingBoard")
    =}

    method board_out(){=
        return self.begin_mission("BoardOut")
    =}

    method show_message(text){=
        self.logger.info(text)
        return True
    =}

    reaction(startup) -> end_mission {=
        self.mission_end = end_mission
        self.busy = self.data_model.get_node("Objects/FlyingProbeTester/Busy")
        self.current_mission = self.data_model.get_node("Objects/FlyingProbeTester/CurrentMission")
        self.last_result = self.data_model.get_node("Objects/FlyingProbeTester/LastResult")
        self.data_model.get_node("Objects/FlyingProbeTester/BoardIn").callback = self.board_in
        self.data_model.get_node("Objects/FlyingProbeTester/StartTest").callback = self.start_test
        self.data_model.get_node("Objects/FlyingProbeTester/BoardOut").callback = self.board_out
        self.data_model.get_node("Objects/FlyingProbeTester/ShowMessage").callback = self.show_message
    =}

    reaction(end_mission){=
        self.running = False
        self.last_result.value = "success"
        self.busy.value = False
        self.current_mission.value = ""
    =}
}
