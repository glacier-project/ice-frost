target Python

import MissionMachine from "base/MissionMachine.lf"

reactor Cell1 extends MissionMachine{
    method mission_nodes(){=
        return ("Cell1/FlyingProbeTester/Busy", "Cell1/FlyingProbeTester/CurrentMission", "Cell1/FlyingProbeTester/LastResult", "")
    =}

    method mission_started(name, duration){=
        if self.result.value:
            self.result.value = False
    =}

    method mission_result(name){=
        board = self.data_model.get_node("Cell1/Board")
        if name == "BoardIn" and board.value != "electronic":
            board.value = ""
            return False
        return True
    =}

    reaction(startup){=
        self.data_model.get_node("Cell1/FlyingProbeTester/ShowMessage").callback = lambda text: self.logger.info(text) or True
    =}
}
