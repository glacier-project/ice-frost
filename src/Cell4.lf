target Python 

import FrostMachine from "../frost/src/lib/FrostMachine.lf"

reactor Cell4 extends FrostMachine{
    //VARIABLES
    state operation_running
    state operation_done 
    state operation_error 
    state abb_prog_running 
    state kuka_prog_running 
    state abb_positions 
    state kuka_positions 
    //METHODS
    state clear_buffer 
    state move_and_place 
    state move_over 
    state pick_from_pallet 
    state place_to_pallet 
    state submit_robot_operation 
    state abb_pick_board 
    state gadget_assembly 
    
    timer check_status(0, 1 sec)

    state invoked = False
    method call_move_and_place(posPickOnPallet, posPlaceOnPallet, posPickOnBuffer, posPlaceFromBufferToPallet){=
        '''
        Method to move and place an item using the robot.
        Args:
            posPickOnPallet (int): Position to pick from the pallet.
            posPlaceOnPallet (int): Position to place on the pallet.
            posPickOnBuffer (int): Position to pick from the buffer.
            posPlaceFromBufferToPallet (int): Position to place from buffer to pallet.
        '''
        self.operation_done.value = False
        self.operation_running.value = True
        self.invoked = True
        return (True, 0)
    =}
    method call_submit_operation(programID, robotID, srcAreaId, srcAreaPosX, srcAreaPosY, dstAreaId, dstAreaPosX, dstAreaPosY, argExtra){=
        '''
        Method to submit the robot operation.
        '''
        self.operation_done.value = False
        self.operation_running.value = True
        self.invoked = True
        return (True, 0)
    =}
    method call_move_over_pallet(posPick, posPlace){=
        '''
        Method to move over a pallet using the robot.
        Args:
            posPick (int): Position to pick from.
            posPlace (int): Position to place to.
        '''
        self.operation_done.value = False
        self.operation_running.value = True
        self.invoked = True
        return (True, 0)
    =}
    method call_pick_from_pallet(posPick, itemShape){=
        '''
        Method to pick an item from the pallet using the robot.
        Args:
            posPick (int): Position to pick from the pallet.
            posPlace (int): Position to place to.
        '''
        self.operation_done.value = False
        self.operation_running.value = True
        pos = 0
        for position in self.abb_positions.children:
            if position.value == 0:
                position.value = 2
                pos = int(position.name)
                break
        self.invoked = True
        return (True, pos, 0)
    =}
    method call_place_to_pallet(posPickOnBuffer, posPlaceOnPallet){=
        '''
        Method to place an item to the pallet using the robot.
        Args:
            posPlace (int): Position to place to the pallet.
            itemShape (int): Shape of the item to place.
        '''
        self.operation_done.value = False
        self.operation_running.value = True
        self.invoked = True
        return (True, 0)
    =}
        
    reaction(startup){=
        '''
        Initialize the Cell4 reactor, setting up the initial state and scheduling the first routine.
        It also sends a registration message to the communication channel.
        '''
        self.operation_running = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksGlobal/DB_ROBOTS/plcOperationRunning")
        self.operation_done = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksGlobal/DB_ROBOTS/plcOperationDone")
        self.operation_error = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksGlobal/DB_ROBOTS/plcOperationError")
        self.abb_prog_running = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksGlobal/DB_ROBOTS/ABB/programRunning")
        self.kuka_prog_running = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksGlobal/DB_ROBOTS/KUKA/programRunning")
        self.abb_positions = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksGlobal/DB_BUFFER/ABBPositions")
        self.kuka_positions = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksGlobal/DB_BUFFER/KUKAPositions")
        #Methods
        self.clear_buffer = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksInstance/OPC_UA_CLEAR_BUFFER_DB")
        self.move_and_place = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksInstance/OPC_UA_MOVE_AND_PLACE_DB")
        self.move_over = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksInstance/OPC_UA_MOVE_OVER_PALLET_DB")
        self.pick_from_pallet = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksInstance/OPC_UA_PICK_FROM_PALLET_DB")
        self.place_to_pallet = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksInstance/OPC_UA_PLACE_TO_PALLET_DB")
        self.submit_robot_operation = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksInstance/OPC_UA_SUBMIT_ROBOT_OPERATION_DB")
        self.abb_pick_board = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksInstance/OPC_UA_ABB_PICK_BOARD_FROM_PALLET_DB")  
        self.gadget_assembly = self.data_model.get_node("Cell4/Cell_4_Robot_Coordinator_PLC/DataBlocksInstance/OPC_UA_GADGET_ASSEMBLY_DB")
        # Callbacks
        self.gadget_assembly.callback = lambda *args, **kwargs: True
        self.move_and_place.callback = self.call_move_and_place
        self.submit_robot_operation.callback = self.call_submit_operation
        self.move_over.callback = self.call_move_over_pallet
        self.pick_from_pallet.callback = self.call_pick_from_pallet
        self.place_to_pallet.callback = self.call_place_to_pallet
    =}

    reaction(check_status){=
        if self.invoked:
            self.logger.info("Operation completed.")
            self.operation_done.value = False
    =}

}
