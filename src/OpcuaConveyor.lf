target Python{
    files: [Conveyor/conveyor_utils.py]
}

import FrostMachine from "../frost/src/lib/FrostMachine.lf"

reactor MetaConveyor extends FrostMachine{

    preamble{=
       from conveyor_utils import (
            conveyor_obj, conveyor_data_exchange, Pallets, Bayes, Segments, Commands, Destinations,
            destination_1_1, destination_5, destination_pallet_id_, destination_ok_,
            commands_pointer, IndexPosition, setDestination, PalletPosition, palletNum,
            Pallet, Pallet1, Pallet2, Pallet3, Pallet4, Pallet5, Pallet6, Pallet7, Pallet8, Pallet9, Pallet10,
            Bay, Bay1, Bay2, Bay3, Bay4, Bay5,
            Segment, Segment1, Segment2, Segment3, Segment4, Segment5, Segment6, Segment7, Segment8,
            FIFO, size, item
        )
    =}

    reaction(startup){=
        self.reservationIds = [0]
        self.reserveFreePalletofType2 = self.data_model.get_node("Cell_Conveyor/ConveyorHMI/ConveyorDataExchange/Commands/UtilityMethods/reservePalletOfType2")
        self.reserveFreePalletofType2.callback = self.call_reserveFreePalletOfType2
        self.getReservedPallet = self.data_model.get_node("Cell_Conveyor/ConveyorHMI/ConveyorDataExchange/Commands/UtilityMethods/getReservedPallet")
        self.getReservedPallet.callback = self.get_reserved_pallet
        self.pallet_1 = self.data_model.get_node(self.conveyor_obj + self.Pallets + self.Pallet1)
        self.pallet_2 = self.data_model.get_node(self.conveyor_obj + self.Pallets + self.Pallet2)
        self.pallet_3 = self.data_model.get_node(self.conveyor_obj + self.Pallets + self.Pallet3)
        self.pallet_4 = self.data_model.get_node(self.conveyor_obj + self.Pallets + self.Pallet4)
        self.pallet_5 = self.data_model.get_node(self.conveyor_obj + self.Pallets + self.Pallet5)
        self.pallet_6 = self.data_model.get_node(self.conveyor_obj + self.Pallets + self.Pallet6)
        self.pallet_7 = self.data_model.get_node(self.conveyor_obj + self.Pallets + self.Pallet7)
        self.pallet_8 = self.data_model.get_node(self.conveyor_obj + self.Pallets + self.Pallet8)
        self.pallet_9 = self.data_model.get_node(self.conveyor_obj + self.Pallets + self.Pallet9)
        self.pallet_10 = self.data_model.get_node(self.conveyor_obj + self.Pallets + self.Pallet10)
        self.pallets = [self.pallet_1, self.pallet_3, self.pallet_4, self.pallet_5, self.pallet_6]
    =}

    method call_reserveFreePalletOfType2(numPallets, contentPos1, contentPos2, contentPos3, palletType){=
        '''
        Reserves free pallets of a specific type.
        Args:
            numPallets (int): Number of pallets to reserve.
            contentPos1 (int): Content position 1.
            contentPos2 (int): Content position 2.
            contentPos3 (int): Content position 3.
            palletType (int): Type of the pallet.
        Returns:
            list: A list containing the reservation status and reservation ID.
        '''
        reservationId = self.reservationIds[-1] + 1
        while reservationId in self.reservationIds:
            reservationId += 1
        self.reservationIds.append(reservationId)
        reserved_count = 0
        for pallet in self.pallets:
            if pallet.get_property("type").value != palletType:
                continue
            
            if pallet.get_property("reserved").value != 0:
                continue

            if pallet.get_property("contentPosition1").value != contentPos1:
                continue
            if pallet.get_property("contentPosition2").value != contentPos2:
                continue
            if pallet.get_property("contentPosition3").value != contentPos3:
                continue

            pallet.get_property("reserved").value = reservationId
            reserved_count += 1
            if reserved_count >= numPallets:
                break

        if reserved_count == numPallets:
            return reservationId
        else:
            raise ValueError("Not enough pallets available to reserve")
    =}

    method get_reserved_pallet(reservationId){=
        """
        Returns a reserved pallet based on the reservation ID.
        Args:
            reservationId (int): The reservation ID to look for.
        """
        assert reservationId in self.reservationIds, "Invalid reservation ID"
        
        for pallet in self.pallets:
            if pallet.get_property("reserved").value == reservationId:
                return int(pallet.name[-1])

        raise ValueError("No pallet found for the given reservation ID")
    =}

}