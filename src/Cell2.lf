target Python

import FrostReactor from <frost/FrostReactor.lf>

reactor Cell2 extends FrostReactor{
    preamble {=
        # durate di cattura della ricetta in secondi
        MISSION_TIME = {"EngraveText": 131.0, "demo_gadget_post": 8.4}
        DEFAULT_TIME = 10.0     # durate standard se la missione non e' presente nella ricetta
    =}
    state busy
    state current_mission
    state last_result
    state running = False
    state mission_end
    logical action end_mission

    method begin_mission(mission){=
        if self.running:
            return False
        self.running = True
        self.current_mission.value = mission
        self.busy.value = True
        seconds = self.MISSION_TIME.get(mission, self.DEFAULT_TIME)
        self.mission_end.schedule(MSEC(int(seconds * 1000)))
        return True
    =}

    method engrave_text(text){=
        self.logger.info(f"Incisione del testo: {text}")
        return self.begin_mission("EngraveText")
    =}

    method start_mission(mission_name){=
        return self.begin_mission(mission_name)
    =}

    reaction(startup) -> end_mission {=
        self.mission_end = end_mission
        self.busy = self.data_model.get_node("Objects/OPCUA/MES/MESBusy")
        self.current_mission = self.data_model.get_node("Objects/OPCUA/MES/CurrentMission")
        self.last_result = self.data_model.get_node("Objects/OPCUA/MES/MESLastResult")
        self.data_model.get_node("Objects/OPCUA/MES/Methods/EngraveText/EngraveText").callback = self.engrave_text
        self.data_model.get_node("Objects/OPCUA/MES/Methods/StartMission/StartMission").callback = self.start_mission
    =}

    reaction(end_mission){=
        self.running = False
        self.current_mission.value = ""
        self.last_result.value = True
        self.busy.value = False
    =}
}
