target Python

import MissionMachine from "base/MissionMachine.lf"

reactor Cell2 extends MissionMachine{
    method mission_nodes(){=
        return ("Cell2/MES/MESBusy", "Cell2/MES/CurrentMission", "Cell2/MES/MESLastResult", "")
    =}

    method mission_finished(name){=
        if name == "engraveText":
            self.data_model.get_node("Cell2/MES/TextToWrite").value = ""
        elif name in ("TakeBoard", "TakeBoardOut"):
            self.data_model.get_node("Cell2/MES/Board").value = name == "TakeBoard"
    =}
}
