target Python{
    fast: False,
    files: [
        "../lf-packages/frost/src/python_lib/frost.py",
        "../lf-packages/frost/src/python_lib/l_formatter.py",
        "../lf-packages/frost/src/python_lib/time_utils.py",
        "python_utils/ice_proxy.py",
        "python_utils/handle_recipe.py",
        "MetaConveyor_utils/pallet_distance.py"
    ],
    logging: error,
    single-threaded: false,
}

import CellConveyor from "CellConveyor.lf"
import MetaConveyor from "MetaConveyor.lf"
import FrostScheduler from <frost/scheduler/FrostScheduler.lf>
import FrostLink from <frost/FrostLink.lf>
import Cell4 from "Cell4.lf"
import Cell5 from "Cell5.lf"
import Cell1 from "Cell1.lf"
import Cell2 from "Cell2.lf"
import Kairos from "Kairos.lf"
import Warehouse from "Warehouse.lf"
import Etensil from "Etensil.lf"
import RecipeTimer from "RecipeTimer.lf"

preamble{= 

import uuid
from frost import *

from frost_planner.generator.instance_generator import load_instance_from_json
from frost_planner.solver.genetic_solver import GeneticAlgorithmSolver
from frost_planner.executor.static_executor import StaticExecutor
from frost_planner.solver.dummy_solver import DummySolver
from frost_planner.executor.dynamic_executor import DynamicExecutor
from frost_planner.core.base import TaskStatus, Task, Job, SchedulingInstance, Machine
from pallet_distance import _get_pallet_metric
from pallet_distance import *
RECIPE_PATH = os.environ.get("RECIPE_PATH")
CONDITIONS_PATH = os.environ.get("CONDITIONS_PATH")
=}


main reactor{
    preamble{=
        recipe_path = os.environ.get("RECIPE_PATH")
        conditions_path = os.environ.get("CONDITIONS_PATH")
    =}
    
    cell4 = new Cell4(name="cell4", update_interval = 100 msec)
    cell5 = new Cell5(name="cell5", update_interval = 100 msec)
    conveyor = new CellConveyor(name="conveyor", _update_step= 1 msec, update_interval = 100 msec)
    scheduler = new FrostScheduler(name = "scheduler", update_interval = 100 msec)
    cell1 = new Cell1(name="cell1", update_interval = 100 msec)
    cell2 = new Cell2(name="cell2", update_interval = 100 msec)
    rbkairos_a = new Kairos(name="rbkairos_a", update_interval = 100 msec)
    rbkairos_b = new Kairos(name="rbkairos_b", update_interval = 100 msec)
    warehouse = new Warehouse(name="warehouse", update_interval = 100 msec)
    etensil = new Etensil(name="etensil", update_interval = 100 msec)

    recipe_timer = new RecipeTimer(name="recipe_timer", update_interval = 100 msec)

    link = new FrostLink(name="frost_link", width = 11)

    conveyor.channel_out, scheduler.channel_out, cell5.channel_out, cell4.channel_out, cell1.channel_out, cell2.channel_out, rbkairos_a.channel_out, rbkairos_b.channel_out, warehouse.channel_out, etensil.channel_out, recipe_timer.channel_out -> link.channel_in after 0
    link.channel_out -> conveyor.channel_in, scheduler.channel_in, cell5.channel_in, cell4.channel_in, cell1.channel_in, cell2.channel_in, rbkairos_a.channel_in, rbkairos_b.channel_in, warehouse.channel_in, etensil.channel_in, recipe_timer.channel_in after 0

}