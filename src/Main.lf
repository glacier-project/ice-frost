target Python{
    fast: True,
    files: [
        "../frost/src/python_lib/frost.py",
        "../frost/src/python_lib/l_formatter.py",
        "../frost/src/python_lib/time_utils.py",
        "python_utils/ice_proxy.py",
        "python_utils/handle_recipe.py",
        "MetaConveyor_utils/pallet_distance.py"
    ],
    logging: error,
    single-threaded: false,
}

import CellConveyor from "CellConveyor.lf"
import MetaConveyor from "MetaConveyor.lf"
import FrostScheduler from "../frost/src/lib/scheduler/FrostScheduler.lf"
import FrostMachine from "../frost/src/lib/FrostMachine.lf"
import FrostBus from "../frost/src/lib/FrostBus.lf"
import Cell4 from "Cell4.lf"
import Cell5 from "Cell5.lf"

preamble{= 

import uuid
from frost import *

from frost_planner.generator.instance_generator import load_instance_from_json
from frost_planner.solver.genetic_solver import GeneticAlgorithmSolver
from frost_planner.executor.static_executor import StaticExecutor
from frost_planner.solver.dummy_solver import DummySolver
from frost_planner.executor.dynamic_executor import DynamicExecutor
from frost_planner.core.base import TaskStatus, Task, Job, SchedulingInstance, Machine
from pallet_distance import _get_pallet_metric
from pallet_distance import *
RECIPE_PATH = os.environ.get("RECIPE_PATH")
CONDITIONS_PATH = os.environ.get("CONDITIONS_PATH")
=}


main reactor{
    preamble{=
        recipe_path = os.environ.get("RECIPE_PATH")
        conditions_path = os.environ.get("CONDITIONS_PATH")
    =}
    
    cell4 = new Cell4(name="cell4")
    
    cell5 = new Cell5(name="cell5")
    conveyor = new CellConveyor(name="conveyor", _update_step= 1 msec)
    scheduler = new FrostScheduler(name = "scheduler")
    bus = new FrostBus(name="frost_bus", width = 4)

    conveyor.channel_out, scheduler.channel_out, cell5.channel_out, cell4.channel_out -> bus.channel_in after 0
    bus.channel_out -> conveyor.channel_in, scheduler.channel_in, cell5.channel_in, cell4.channel_in after 0
}