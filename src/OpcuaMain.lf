=}

main reactor {
    conveyor = new OpcuaConveyor(name="conveyor")
    scheduler = new FrostScheduler(name="scheduler")
    link = new FrostLink(name="frost_link", width = 4)
    cell4 = new FrostReactor(name="cell4")
    cell5 = new FrostReactor(name="cell5")

    conveyor.channel_out, scheduler.channel_out, cell4.channel_out, cell5.channel_out -> link.channel_in after 0
    link.channel_out -> conveyor.channel_in, scheduler.channel_in, cell4.channel_in, cell5.channel_in after 0
}
