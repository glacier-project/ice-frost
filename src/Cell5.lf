target Python

import FrostReactor from <frost/FrostReactor.lf>
import FrostFmu from <frost/simulation/FrostFmu.lf>

reactor Cell5 extends FrostReactor, FrostFmu{

    state num_gadget_checks
    state num_lego_checks
    state num_total_checks
    state num_gadget_failures
    state num_lego_failures
    state num_total_failures
    state last_result
    state current_mission
    state busy
    state result_ready
    state result
    state mission = ""
    state fmu_cleared = True
    state pending_inputs

    method _start_check(mission, inputs){=
        # queued: inputs set before the FMU tick of this tag would leak into the previous step
        self.mission = mission
        self.busy.value = True
        self.current_mission.value = "CheckObject"
        self.result_ready.value = False
        self.num_total_checks.value = self.num_total_checks.value + 1
        counter = self.num_gadget_checks if mission == "gadget" else self.num_lego_checks
        counter.value = counter.value + 1
        self.pending_inputs = inputs
    =}

    method _apply_check(tick){=
        # wait until the FMU clears the last result ("none"), else it answers with it
        if not (self.fmu_cleared and self.pending_inputs):
            return
        self.fmu_inputs.update(self.pending_inputs)
        self.pending_inputs = None
        if self._set_trigger():
            self._set_inputs()
            self._commit()
            self._resume(tick)
        else:
            self.logger.warning(f"check inputs at {lf.time.logical_elapsed()} ns only enter the next FMU step")
    =}

    method check_color(color){=
        """
        Checks if the color of the covers matches the expected color.
        Args:
            color (str): The color of the cover to check.
        """
        self.logger.info(f"Checking cover color: {color}")
        self._start_check("gadget", {"quality_input": color})
        return False
    =}

    method check_shape(shape1, shape2, shape3, pallet_content1, pallet_content2, pallet_content3){=
        """
        Checks if the shapes of the LEGO pieces match the expected shapes.

        Args:
            shape1 (int): The shape of the first LEGO piece.
            shape2 (int): The shape of the second LEGO piece.
            shape3 (int): The shape of the third LEGO piece.
            pallet_content1 (int): The content of the first pallet position.
            pallet_content2 (int): The content of the second pallet position.
            pallet_content3 (int): The content of the third pallet position.
        """
        self.logger.info(f"Checking LEGO shapes: {shape1}, {shape2}, {shape3} with pallet contents: {pallet_content1}, {pallet_content2}, {pallet_content3}")
        self._start_check("lego", {
            "shape1": shape1, "shape2": shape2, "shape3": shape3,
            "pallet_position_1": pallet_content1, "pallet_position_2": pallet_content2, "pallet_position_3": pallet_content3,
        })
        return True
    =}

    method _publish(result){=
        passed = result == "success"
        if result == "error":
            self.logger.error(f"QualityCell FMU rejected the {self.mission} check: another check is running")
        else:
            self.logger.info(f"{self.mission} check: {result}")
        if not passed:
            self.num_total_failures.value = self.num_total_failures.value + 1
            counter = self.num_gadget_failures if self.mission == "gadget" else self.num_lego_failures
            counter.value = counter.value + 1
        self.fmu_inputs.update(
            quality_input="", shape1=0, shape2=0, shape3=0,
            pallet_position_1=0, pallet_position_2=0, pallet_position_3=0,
        )
        self.fmu_cleared = False
        self.result.value = passed
        self.last_result.value = passed
        self.current_mission.value = ""
        self.busy.value = False
        self.result_ready.value = True
    =}

    // @override
    method _commit(){=
        result = self.model.read("result")
        self.logger.debug(f"values: input={self.fmu_inputs.get('quality_input')}, output={result}")
        if result == "none":
            self.fmu_cleared = True
            if self.pending_inputs:
                self.fmu_inputs.update(self.pending_inputs)
                self.pending_inputs = None
        elif self.busy.value and self.fmu_cleared and result in ("success", "failed", "error"):
            self._publish(result)
        self._set_inputs()
        return True
    =}

    // @label apply_method_inputs
    reaction(request_messages) -> tick{=
        self._apply_check(tick)
    =}

    // @label apply_resumed_method_inputs
    reaction(response_messages) -> tick{=
        self._apply_check(tick)
    =}

    // @label startup_reaction
    reaction(startup){=
        # Initialize data model nodes
        self.num_gadget_checks = self.data_model.get_node("Cell5/Statistics/ChecksGadget")
        self.num_lego_checks = self.data_model.get_node("Cell5/Statistics/ChecksLego")
        self.num_total_checks = self.data_model.get_node("Cell5/Statistics/ChecksTotal")
        self.num_gadget_failures = self.data_model.get_node("Cell5/Statistics/FaultsGadget")
        self.num_lego_failures = self.data_model.get_node("Cell5/Statistics/FaultsLego")
        self.num_total_failures = self.data_model.get_node("Cell5/Statistics/FaultsTotal")
        self.last_result = self.data_model.get_node("Cell5/Status/LastResult")
        self.busy = self.data_model.get_node("Cell5/Status/Busy")
        self.current_mission = self.data_model.get_node("Cell5/Status/CurrentMission")
        self.current_mission.value = ""
        self.result_ready = self.data_model.get_node("Cell5/results/result_ready")
        self.result = self.data_model.get_node("Cell5/results/result")

        # Set callbacks
        self.data_model.get_node("Cell5/Methods/CheckQualityCovers").callback = self.check_color
        self.data_model.get_node("Cell5/Methods/CheckQualityLego").callback = self.check_shape
    =}

}
